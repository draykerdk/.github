{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/draykerdk/.github/blob/master/schema/component.schema.json",
  "title": "Drayker public component contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "layer",
        "artifact_type",
        "problem",
        "scope",
        "non_scope",
        "dependencies",
        "implementation",
        "risks",
        "contributions",
        "source_of_truth",
        "last_reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "enum": ["KERNEL", "NETWORK", "SECURITY", "DEVICES", "PLATFORM", "PROTOCOL", "ORGANIZATION", "KNOWLEDGE", "COMMUNITY", "PORTAL"]
        },
        "artifact_type": {
          "enum": ["architecture", "research-proposal", "protocol", "governance-proposal", "project-framework", "community-entrypoint", "knowledge-base", "portal", "theme"]
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "non_scope": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "scope", "evidence"],
          "properties": {
            "level": {
              "enum": ["none", "prototype", "operational"]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "ref"],
                "properties": {
                  "type": {
                    "enum": ["document", "prototype", "deployment", "test", "usage"]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "risks": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "contributions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "entrypoint"],
          "properties": {
            "availability": {
              "enum": ["open", "paused", "closed"]
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_of_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://github\\.com/draykerdk/"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
